# Only dependency manifests and application source enter the build context.
# Docker sends the selected Dockerfile and this ignore file separately.
**
!pyproject.toml
!uv.lock
!langgraph_agent_toolkit/
!langgraph_agent_toolkit/**

# Keep local secrets and generated files out of the application source copy.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.git
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.DS_Store
**/*.log
**/*.db
**/*.sqlite
**/*.sqlite3
**/*-journal
**/*-wal
**/*-shm
