{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv run python:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv tree:*)",
      "Bash(uv pip list:*)",
      "Bash(uv build:*)",
      "Bash(make uv_install_deps:*)",
      "Bash(make uv_install_deps_compile:*)",
      "Bash(make uv_get_lock:*)",
      "Bash(make uv_update_deps:*)",
      "Bash(make uv_show_deps:*)",
      "Bash(make uv_show_deps_tree:*)",
      "Bash(make uv_build_wheel:*)",
      "Bash(make pre_commit_install:*)",
      "Bash(make pre_commit_run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.local.env)",
      "Read(./.*.env)",
      "Read(./configs/**/*.env)",
      "Read(./configs/**/.*.env)",
      "Read(./configs/litellm/config.yaml)"
    ]
  }
}
