# Set the web server address and port.
HOST=0.0.0.0
PORT=8080

# Do not log redirection responses.
SKIP_REDIRECTION_LOGGING=true

# Set the application mode. `dev` enables Uvicorn reload.
ENV_MODE=development

# Use one shared secret for one client deployment.
# The trusted client application supplies user_id for its own users.
AUTH_MODE=trusted
AUTH_SECRET=
AUTH_SERVICE_USER_ID=service
# Optional: use AUTH_MODE=token when untrusted users connect directly to this API.
# Then each AUTH_USERS token identifies one user; a supplied user_id must match.
# AUTH_USERS={"user-1":"replace-with-user-token"}
# Set a separate server-only secret to enable feedback from token users.
# Use at least 32 random characters. Do not use a client bearer token.
# Keep the same value across workers, replicas, and restarts.
# FEEDBACK_SIGNING_SECRET=

# Select an observability backend.
# OBSERVABILITY_BACKEND=langfuse
# Limit how long graceful shutdown waits for a telemetry flush.
OBSERVABILITY_SHUTDOWN_TIMEOUT=10

# Langfuse configuration
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=http://langfuse-web:3000
# Optional current SDK URL alias. It takes precedence over LANGFUSE_HOST.
# LANGFUSE_BASE_URL=http://langfuse-web:3000

# LangSmith configuration
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Select a memory backend.
# `postgres` requires the PostgreSQL variables.
# `sqlite` accepts an optional `SQLITE_DB_PATH` value.
MEMORY_BACKEND=postgres

# Set this value when `MEMORY_BACKEND=sqlite`.
SQLITE_DB_PATH=

# Set these values when `MEMORY_BACKEND=postgres`.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=agents
# Configure the PostgreSQL connection pool.
# Set `POSTGRES_POOL_SIZE` below the available PostgreSQL connection count.
# With `max_connections=181`, reserve about 30 connections for administration and monitoring.
# Total upper bound = workers * (checkpoint pool + lock pool), plus stores/admin.
POSTGRES_POOL_SIZE=20
POSTGRES_LOCK_POOL_SIZE=10
POSTGRES_POOL_MAX_WAITING=100
POSTGRES_MIN_SIZE=2
POSTGRES_MAX_IDLE=120
POSTGRES_POOL_TIMEOUT=45.0
POSTGRES_RECONNECT_TIMEOUT=60.0
# Bound connection establishment and each health probe in seconds.
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_HEALTH_CHECK_TIMEOUT=5.0
# TCP liveness settings. Support depends on the operating system.
POSTGRES_KEEPALIVES_IDLE=30
POSTGRES_KEEPALIVES_INTERVAL=10
POSTGRES_KEEPALIVES_COUNT=3
# Milliseconds; ignored on systems without TCP_USER_TIMEOUT.
POSTGRES_TCP_USER_TIMEOUT=60000
# Set the maximum connection lifetime in seconds. The pool replaces older connections.
POSTGRES_MAX_LIFETIME=300.0
# Set the number of pool-maintenance workers.
# POSTGRES_NUM_WORKERS=3
# Set PostgreSQL query timeouts in milliseconds.
# Set this value above the expected model latency and retry time.
POSTGRES_STATEMENT_TIMEOUT=120000
# Set the maximum lock wait. Concurrent requests for the same `thread_id` wait.
POSTGRES_LOCK_TIMEOUT=45000
# Set the maximum idle transaction time. Set this value above the expected model latency.
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=120000

# Bound conversation waiting, run duration, and request body size.
THREAD_QUEUE_MAX_WAITERS=32
THREAD_QUEUE_TIMEOUT=60
THREAD_LOCK_HEARTBEAT=5
THREAD_LOCK_HEARTBEAT_TIMEOUT=5
REQUEST_TIMEOUT=300
# Mark health probes unhealthy if cancellation cleanup exceeds this many seconds.
REQUEST_CLEANUP_TIMEOUT=10.0
# Per worker: reject excess work with HTTP 503 before reading its body.
REQUEST_MAX_CONCURRENT=8
REQUEST_QUEUE_MAX_WAITERS=0
REQUEST_QUEUE_TIMEOUT=1.0
# Bound each response send, including streaming writes, in seconds.
RESPONSE_SEND_TIMEOUT=30.0
REQUEST_MAX_BYTES=20971520
HISTORY_MAX_PAGE_SIZE=1000

# Set the Streamlit agent URL. The default is `http://{HOST}:{PORT}`.
# AGENT_URL=http://0.0.0.0:8080

# Use a fake model for tests.
USE_FAKE_MODEL=false

# OpenAI settings
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_API_VERSION=
OPENAI_MODEL_NAME=

# Managed OpenAI/Azure connections, per worker and endpoint/credential configuration.
# The API Docker image installs and selects aiohttp. Python installs default to httpx.
# Leave the selection unset to use that environment's default.
# Other installs need the openai-aiohttp extra before selecting aiohttp.
# LLM_HTTP_ASYNC_TRANSPORT=aiohttp
LLM_HTTP_MAX_CONNECTIONS=100
LLM_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
LLM_HTTP_KEEPALIVE_EXPIRY=30.0
LLM_HTTP_CONNECT_TIMEOUT=10.0
LLM_HTTP_READ_TIMEOUT=120.0
LLM_HTTP_WRITE_TIMEOUT=30.0
LLM_HTTP_POOL_TIMEOUT=10.0
LLM_HTTP_MAX_RETRIES=2
LLM_HTTP_SHUTDOWN_TIMEOUT=10.0
LLM_HTTP_MAX_POOLS=32

# Azure OpenAI settings
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Anthropic settings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=

# Google Vertex AI settings
GOOGLE_VERTEXAI_MODEL_NAME=
GOOGLE_VERTEXAI_API_KEY=

# Google GenAI settings
GOOGLE_GENAI_MODEL_NAME=
GOOGLE_GENAI_API_KEY=

# Bedrock settings
AWS_BEDROCK_MODEL_NAME=

# DeepSeek settings
DEEPSEEK_MODEL_NAME=
DEEPSEEK_API_KEY=

# Ollama settings
OLLAMA_MODEL_NAME=
OLLAMA_BASE_URL=

# OpenRouter settings
OPENROUTER_API_KEY=

# Define model configurations. Use line continuation to improve readability.
# Use this value to select different models for agents or providers.
MODEL_CONFIGS={"router":{"provider":"azure_openai","model_name":"gpt-4o","openai_api_key":"your-azure-key-here","azure_endpoint":"https://your-resource.openai.azure.com/","openai_api_version":"2024-12-01-preview","deployment_name":"gpt-4o-deployment"},"assistant":{"provider":"azure_openai","model_name":"gpt-4o-mini","openai_api_key":"your-azure-key-here","azure_endpoint":"https://your-resource.openai.azure.com/","openai_api_version":"2024-12-01-preview","deployment_name":"gpt-4o-mini-deployment"},"analyzer":{"provider":"google_genai","model_name":"gemini-pro","api_key":"your-google-key-here","temperature":0.7}}
MODEL_CONFIGS_BASE64=
MODEL_CONFIGS_PATH=
# Optional Deep Agents blueprint: put its startup model under MODEL_CONFIGS.deep_agent.
# Example: {"deep_agent":{"provider":"openai","name":"your-model-name"}}
# Install the deepagents extra and select its AGENT_PATHS entry. See docs/deepagents.rst.

# Set the Amazon Bedrock Knowledge Base ID.
AWS_KB_ID=

# Detect and resume human-in-the-loop interruptions. The default is `true`.
# Set this value to `false` if no agent calls `interrupt()`.
CHECK_INTERRUPTS=

# Install the mcp extra to connect agents to MCP tools. See docs/mcp.rst.
MCP_SERVERS={}
# Empty selects all configured servers for the default agent.
MCP_AGENT_SERVERS={}
# Bound total tool discovery time during worker startup, in seconds.
MCP_DISCOVERY_TIMEOUT=30
# Example: read the full Authorization header from DOCUMENTS_MCP_AUTH.
# MCP_SERVERS={"docs":{"url":"https://mcp.example.com/mcp","headers_env":{"Authorization":"DOCUMENTS_MCP_AUTH"},"timeout":30,"tool_allowlist":["search"]}}
# MCP_AGENT_SERVERS={"create-agent":["docs"],"react-agent":["docs"]}
# DOCUMENTS_MCP_AUTH=
# For stdio, set transport, command, and args explicitly.
# MCP_SERVERS={"local":{"transport":"stdio","command":"python","args":["/app/mcp_server.py"]}}

# Set the maximum number of non-text attachments per message. Leave this value empty for no toolkit limit.
# The model provider still enforces its own model-specific limits.
MULTIMODAL_MAX_ATTACHMENTS=

# Set defaults for `ClearIntermediateToolCallsMiddleware`.
# Use `name_args` to collapse identical calls. Use `name` to collapse all calls to a tool.
# Set the number of recent results to keep for each key in earlier turns.
CLEAR_INTERMEDIATE_TOOL_CALLS=
CLEAR_INTERMEDIATE_TOOL_CALLS_BY=
CLEAR_INTERMEDIATE_TOOL_CALLS_KEEP_LAST_N=

# Opt-in real OpenAI tests. Export these values in the test environment.
# Tests do not load these values from .env. See docs/live_llm_testing.rst.
# LAT_TEST_OPENAI_API_KEY=
# LAT_TEST_OPENAI_MODEL=gpt-5.4
# LAT_TEST_OPENAI_MODEL_KWARGS={"reasoning_effort":"none"}
# LAT_TEST_LLM_CHILD is an internal gate set only by the test harness.
